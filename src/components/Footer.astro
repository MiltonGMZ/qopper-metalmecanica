---
const cols = [
  {
    title: 'Empresa',
    links: [
      { label: 'Soluciones', href: '#soluciones' },
      { label: 'Tecnología', href: '#tecnologia' },
      { label: 'Proyectos', href: '#proyectos' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Términos y condiciones', href: '#' },
      { label: 'Política de privacidad', href: '#' },
      { label: 'Garantía de producto', href: '#' },
    ],
  },
];
---

<footer id="contacto" class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="#top" class="footer__logo">
          <span class="footer__logo-mark">Q</span>
          QOPPER<span>S.A.S</span>
        </a>
        <p class="footer__tag">Ingeniería de precisión metalmecánica desde 2007.</p>

        <div class="footer__contact">
          <a href="mailto:qoppersas@outlook.com">qoppersas@outlook.com</a>
          <a href="tel:+573143117571">+57 314 311 7571</a>
        </div>
      </div>

      {cols.map((col) => (
        <div class="footer__col">
          <p class="eyebrow">{col.title}</p>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer__col">
        <p class="eyebrow">Síguenos</p>
        <div class="footer__social">
          <a href="https://www.facebook.com/Qopper-SAS-2181838048498645/" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 8h2V5h-2c-2.2 0-4 1.8-4 4v2H9v3h2v7h3v-7h2.5l.5-3H14V9c0-.6.4-1 1-1Z" fill="currentColor"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 10.5v6M7.5 7.5v.01M12 16.5v-3.5c0-1.1.9-2 2-2s2 .9 2 2v3.5M12 13v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="ruler footer__ruler" aria-hidden="true">
      {Array.from({ length: 80 }).map(() => <span></span>)}
    </div>

    <div class="footer__bottom">
      <p>© {new Date().getFullYear()} Qopper S.A.S. Todos los derechos reservados.</p>
      <p>Bogotá D.C., Colombia</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-black);
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2rem;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: 0.05em;
    font-size: 1.1rem;
  }

  .footer__logo span {
    color: var(--c-red);
    margin-left: 0.3em;
    font-size: 0.8em;
  }

  .footer__logo-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    font-size: 0.95rem;
    color: var(--c-black);
    background: var(--c-red);
    clip-path: polygon(0 0, 100% 0, 100% 75%, 75% 100%, 0 100%);
  }

  .footer__tag {
    margin-top: 1rem;
    max-width: 32ch;
    font-size: 0.9rem;
  }

  .footer__contact {
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--f-mono);
    font-size: 0.82rem;
  }

  .footer__contact a { color: var(--c-white); transition: color 0.3s var(--ease); }
  .footer__contact a:hover { color: var(--c-red); }

  .footer__col ul {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer__col a {
    font-size: 0.88rem;
    color: var(--c-gray);
    transition: color 0.3s var(--ease);
  }

  .footer__col a:hover { color: var(--c-white); }

  .footer__social {
    margin-top: 1.2rem;
    display: flex;
    gap: 0.9rem;
  }

  .footer__social a {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    color: var(--c-gray);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .footer__social a:hover {
    border-color: var(--c-red);
    color: var(--c-red);
  }

  .footer__ruler { margin-top: 3.5rem; opacity: 0.5; }

  .footer__bottom {
    margin-top: 1.4rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--c-gray);
  }

  @media (max-width: 880px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .footer__top { grid-template-columns: 1fr; }
  }
</style>
